#!/bin/sh
#
# This file is managed by scripts/install-hook.sh (source: scripts/hooks/templates/). Do not edit directly.

# Local branch guard: no rebasing main (a rebase with clean picks, or one finished by
# `git rebase --continue`, would rewrite main without running pre-commit).
# Git passes the upstream as $1 and the branch being rebased as $2 (empty: the current branch).
# Fails closed: a missing guard refuses the rebase (KINETIC_ALLOW_MAIN=1 skips it once).
GUARD="$(git rev-parse --git-path hooks)/branch-guard.sh"
if [ -f "$GUARD" ]; then
    exec sh "$GUARD" rebase "$2"
fi
if [ "$KINETIC_ALLOW_MAIN" != "1" ]; then
    echo "pre-rebase: REFUSED: the branch guard is not installed ($GUARD)." >&2
    echo "pre-rebase: reinstall the hooks: sh scripts/install-hook.sh (or scripts/install-hook.ps1)." >&2
    echo "pre-rebase: (deliberate repair only: KINETIC_ALLOW_MAIN=1 skips this guard once)" >&2
    exit 1
fi
exit 0
